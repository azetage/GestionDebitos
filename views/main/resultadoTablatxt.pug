extends ../layout/plantilla  

  
block contenido
  a.text-gray-500.px-10.font-semibold.py-3.border-2.border-solid.shadow-md.cursor-pointer.rounded-sm.justify-items-end(class= "shadow-lg shadow-blue-500/50" href="/main/recepcionDebitos") INICIO  
  br
  br

  h2.py-2.text-center.text-2xl.font-bold.text-white.bg-sky-500(class= "shadow-lg shadow-blue-500/50")= pagina
        
    h3.py-2.text-center.text-xl.font-bold= archivo

    div.mt-10.mx-auto.max-w-7xl.px-6
        h2 Listado de Débitos

        div(class="overflow-y-auto max-h-96")    

            table#TablaDebitosTxT.table-auto.w-full.border-collapse.border
                thead.bg-gray-200
                    tr
                        each key in Object.keys(data[0])
                            th.border.px-2.py-1= key

                tbody
                    each row in data
                        tr
                            each key in Object.keys(row)
                                td.border.px-2.py-1= row[key]


        div(class="grid gap-6 mb-3 md:grid-cols-2 shadow-lg shadow-gray-500/50").py-2.text-xl.font-bold.bg-gray-200.text-gray-500.py-3
                            div
                                h4 Elementos : #{cantidad}
                            div
                                h4 Monto Total : #{suma} 
    script.
        $(document).ready(function () {
            $('#TablaDebitosTxT').DataTable({
            paging: false,
            searching: true,
            ordering: true,
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.8/i18n/es-ES.json"
            }
            });
            // activar encabezados fijos
            new $.fn.dataTable.FixedHeader(table);
        });