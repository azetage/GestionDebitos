extends ../layout/plantilla  

block contenido
  
    br
    br
    h2.py-2.text-center.text-2xl.font-bold.text-white.bg-sky-500(class= "shadow-lg shadow-blue-500/50")= pagina
    if errores 
        div(class="max-w-md mx-auto my-10")
            each error in errores
                p(class= "bg-red-600 text-white uppercase text-xs text-center p-2 mb-1 font-bold")= error.msg
    div(name= 'busqueda_principal')
        div.mt-8.mx-auto.max-w-full.px-6.text-sm.items-center

            .bg-white.py-8.px-10(class="shadow-lg shadow-gray-500/50")
                form.space-y-5(method= "GET" action="/main/enviodebitos/consultasDebito" name="formConsulta" noValidate)
                    fieldset.px-10.py-1 
                        legend.px-3.py-3.mt-2.font-bold  CONSULTA POR ORGANISMO 

                            div.py-10(class="grid gap-6 mb-3 md:grid-cols-3")
                                div(class= "inline-flex flex flex-row")   
                                    label.py-2.px-2.block.h-3.uppercase.text-gray-500.mb-2.font-bold(for="enviosOrganismo") ORGANISMO
                                    div
                                    select#enviosOrganismo(type ='select' placeholder='Seleccione Organismo' name = 'enviosOrganismo')
                                            for item in Organismos? Organismos:''
                                                option(value=item.COD_DEB) #{item.REGISTRA}
                                
                                div(class= "inline-flex flex flex-row")   
                                    label.py-2.px-2.block.h-3.uppercase.text-gray-500.mb-2.font-bold(for="enviosPeriodo") PERIODO
                                    div(class= "inline-flex flex flex-row")   
                                    - const fechaHoy = new Date().toISOString().split('T')[0] 
                                        input#enviosPeriodo.w-full.italic.px-3.py-2.border.border-gray-300.rounded-md.placeholder-gray-400(class="placeholder:italic placeholder:text-sm" placeholder="ingrese FECHA" type="date" name="enviosPeriodo" value = fechaHoy )
                                
                    
                                                        
                                div(class= "inline-flex flex flex-row")
                                        input(  class= "shadow-lg shadow-blue-500/50 w-full text-white font-semibold py-3 shadow-md cursor-pointer rounded-sm bg-sky-500 hover:bg-sky-700 focus:outline-2 focus:outline-offset-2 focus:outline-sky-500 active:bg-sky-700" 
                                            type= 'submit' value= 'BUSCAR')
                            

    div(name= 'debitos')            
        div.mt-8.mx-auto.max-w-full.px-6.items-center
            .bg-white.py-8.px-10(class="shadow-lg shadow-gray-500/50")
                .space-y-5
                    fieldset.px-10.py-1 
                        legend.px-3.py-3.mt-2.font-bold LISTADO DE DEBITOS 
                        div(class="overflow-y-auto max-h-96")    
                            table.text-sm.border-collapse.border.border-slate-900.table-fixed(class="min-w-full table-auto border border-gray-300")
                                thead.bg-gray-200.text-gray-500
                                    tr
                                        th.border.border-slate-300.px-4.sticky.top-0.z-10.bg-gray-200 #
                                        th.border.border-slate-300.px-4.sticky.top-0.z-10.bg-gray-200 OPERATORIA
                                        th.border.border-slate-300.px-4.sticky.top-0.z-10.bg-gray-200 CODIGO
                                        th.border.border-slate-300.px-4.sticky.top-0.z-10.bg-gray-200 AGENTE
                                        th.border.border-slate-300.px-4.sticky.top-0.z-10.bg-gray-200 APELLIDO Y NOMBRE
                                        th.border.border-slate-300.px-4.sticky.top-0.z-10.bg-gray-200 DNI
                                        th.border.border-slate-300.px-4.sticky.top-0.z-10.bg-gray-200 MONTO CUOTA 
                                   

                                tbody
                                    
                                    each item,i in datos? datos:''    

                                        tr.bg-white
                                            td.italic.border.border-slate-300.px-4 #{i+1}
                                            td.italic.border.border-slate-300.px-4= item.OPERATORIA
                                            td.italic.border.border-slate-300.px-4= item.COD
                                            td.italic.border.border-slate-300.px-4= item.NRO_AGENTE
                                            td.italic.border.border-slate-300.px-4= item.APEYNOM
                                            td.italic.border.border-slate-300.px-4= item.DNI_DESC
                                            - const valor = item.MTO_CUO.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' })
                                            td.italic.border.border-slate-300.px-4= valor
                                            

    
                    h2.py-2.text-center.text-2xl.font-bold.text-white.bg-gray-500(class= "shadow-lg shadow-gray-500/50")= totalPesos

    div(name= 'Generar Excel')
        div.mt-8.mx-auto.max-w-full.px-6.text-sm.items-center
            .bg-white.py-8.px-10(class="shadow-lg shadow-gray-500/50")
                form.space-y-5(action=`/main/index/generarExcel` method="GET")   
                    fieldset.px-10.py-1 
                        legend.px-3.py-3.mt-2.font-bold GENERAR ARCHIVO EXCEL 
                            div
                                input(  class= "shadow-lg shadow-blue-500/50 w-full text-white font-semibold py-3 shadow-md cursor-pointer rounded-sm bg-sky-500 hover:bg-sky-700 focus:outline-2 focus:outline-offset-2 focus:outline-sky-500 active:bg-sky-700" 
                                        type= 'submit' value= 'Generar')