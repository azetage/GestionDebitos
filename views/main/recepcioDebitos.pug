extends ../layout/plantilla  

block contenido
  a.text-gray-500.px-10.font-semibold.py-3.border-2.border-solid.shadow-md.cursor-pointer.rounded-sm.justify-items-end(class= "shadow-lg shadow-blue-500/50" href="/main/index") INICIO        

  div.mt-10.mx-auto.max-w-6xl.px-6

    .bg-gray-100.py-10.px-10.shadow-lg

      form.space-y-5(
        method="POST" 
        action="/upload" 
        enctype="multipart/form-data"
      )

        legend.font-bold.text-lg.mb-6 CARGAR ARCHIVO - DÉBITO ORGANISMO
        div.py-10(
            class="grid gap-6 mb-3 md:grid-cols-3 items-stretch"
        )

            div(class="flex flex-col h-full justify-between")
                label.py-2.px-2.block.uppercase.text-gray-500.font-bold(
                    for="enviosPeriodo"
                ) PERIODO

                - const fechaHoy = new Date().toISOString().split('T')[0]

                input#enviosPeriodo.w-full.italic.px-3.py-2.border.border-gray-300.rounded-md.placeholder-gray-400(
                    class="placeholder:italic placeholder:text-sm h-[42px]"
                    placeholder="Ingrese FECHA"
                    type="month"

                    name="recepcionPeriodo"
                    value=fechaHoy.slice(0, 7)
                )

            div(class="flex flex-col h-full justify-between")
                label.py-2.px-2.block.uppercase.text-gray-500.font-bold
                    | ARCHIVO

                input(
                    type="file"
                    name="archivoExcel"
                    accept=".xlsx,.xls"
                    required
                    class="h-[42px]"
                )

            div(class="flex flex-col h-full justify-end")
                label.py-2.px-2.block.uppercase.text-gray-500.font-bold
                    

                input(
                    type="submit"
                    value="CARGAR DEBITO"
                    class="bg-sky-600 hover:bg-sky-800 text-white font-bold py-2 px-6 rounded h-[42px]"
                )

  div(name= 'CONSULTA GRABADOS')            
    div.mt-8.mx-auto.max-w-full.px-6.items-center
        .bg-white.py-8.px-10(class="shadow-lg shadow-gray-500/50")
            
            .space-y-5
                fieldset.px-10.py-1 
                    legend.px-3.py-3.mt-2.font-bold DEBITOS RECEPCIONADOS:   
                        
                    div(class="overflow-y-auto max-h-96")    
                        table#TablaDebitos.text-sm.border-collapse.border.border-slate-900.table-fixed(class="min-w-full table-auto border border-gray-300")
                            thead.bg-gray-200.text-gray-500.py-3
                                tr
                                    th.border.border-slate-300.px-4.sticky.top-0.z-10.bg-gray-200 #
                                    th.border.border-slate-300.px-4.sticky.top-0.z-10.bg-gray-200 PERIODO
                                    th.border.border-slate-300.px-4.sticky.top-0.z-10.bg-gray-200 ORGANISMO
                                    th.border.border-slate-300.px-4.sticky.top-0.z-10.bg-gray-200 COD_DEB
                                    th.border.border-slate-300.px-4.sticky.top-0.z-10.bg-gray-200 CANTIDAD DE REGISTROS
                                    th.border.border-slate-300.px-4.sticky.top-0.z-10.bg-gray-200 MONTO
                                    th.border.border-slate-300.px-4.sticky.top-0.z-10.bg-gray-200 ACCION
                                
                                tbody
                                    each item, i in (tablaAux || [])
                                        - var valor = Number(item.MONTO_TOTAL || 0).toLocaleString('es-AR', { style: 'currency', currency: 'ARS' })

                                        tr.bg-white
                                            td.italic.border.border-slate-300.px-4 #{i + 1}
                                            td.italic.border.border-slate-300.px-4 #{item.PERIODO}
                                            td.italic.border.border-slate-300.px-4 #{item.ORGANISMO || ''}
                                            td.italic.border.border-slate-300.px-4 #{item.COD_DEB || ''}
                                            td.italic.border.border-slate-300.px-4 #{item.REGISTROS || 0}
                                            td.italic.border.border-slate-300.px-4 #{valor}

                                            td.italic.border.border-slate-300.px-4
                                                button.btn-accion(
                                                    class="shadow-lg shadow-sky-500/50 w-full text-white font-semibold py-3 shadow-md cursor-pointer rounded-sm bg-sky-500 hover:bg-sky-700 focus:outline-2 focus:outline-offset-2 focus:outline-sky-500 active:bg-sky-700"
                                                    data-id= item.COD_DEB
                                                    data-periodo= item.PERIODO

                                                ) Ejecutar
                                                        

    div(name= 'COINCIDENCIAS')            
        div.mt-8.mx-auto.max-w-full.px-6.items-center
            legend.px-3.py-3.mt-2.font-bold COINCIDENCIAS:   
                    
            .bg-white.py-8.px-10(class="shadow-lg shadow-gray-500/50")
                div(class="overflow-y-auto max-h-96")  
                table.text-sm.border-collapse.border.border-slate-900.table-fixed(class="min-w-full table-auto border border-gray-300")
                    thead.bg-gray-200.text-gray-500.py-3
                        tr
                            th.border.border-slate-300.px-4.py-2 #
                            th.border.border-slate-300.px-4.py-2 Periodo 
                            th.border.border-slate-300.px-4.py-2 Nro Agente
                            th.border.border-slate-300.px-4.py-2 Apellido y Nombre
                            th.border.border-slate-300.px-4.py-2 CUIL
                            th.border.border-slate-300.px-4.py-2 Registros
                            th.border.border-slate-300.px-4.py-2 Monto Envío
                            th.border.border-slate-300.px-4.py-2 Monto Recepción
                            th.border.border-slate-300.px-4.py-2 Coincide

                    tbody#tablaResultado


    script.
        $(document).on('click', '.btn-accion', function () {
            const cod_deb = $(this).data('id');
            const periodo = $(this).data('periodo');

            $.ajax({
                url: '/main/index/compararDebitos',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ cod_deb, periodo  }),

                success: function (coincidencias) {
                    console.log(coincidencias[0]);

                    $('#tablaResultado').html('');

                    coincidencias.forEach(function (item, i) {
                        $('#tablaResultado').append(`
                            <tr>
                                <td class="border border-slate-300 px-4 py-2">${i+1}</td>
                                <td class="border border-slate-300 px-4 py-2">${item.periodo}</td>
                                <td class="border border-slate-300 px-4 py-2">${item.nro_agente}</td>
                                <td class="border border-slate-300 px-4 py-2">${item.apeynom}</td>
                                <td class="border border-slate-300 px-4 py-2">${item.cuil}</td>
                                <td class="border border-slate-300 px-4 py-2">${item.cantidad_registros}</td>
                                <td class="border border-slate-300 px-4 py-2">${item.monto_envio}</td>
                                <td class="border border-slate-300 px-4 py-2">${item.monto_recepcion}</td>
                                <td class="border border-slate-300 px-4 py-2">
                                    ${item.coincide ? 'SI' : 'NO'}
                                </td>
                            </tr>
                        `);
                    });
                },

                error: function () {
                    alert('Error al ejecutar');
                }
            });
        });