extends ../layout/plantilla  

block contenido
  div.mt-10.mx-auto.max-w-6xl.px-6

    .bg-gray-100.py-10.px-10.shadow-lg

      form.space-y-5(
        method="POST" 
        action="/upload" 
        enctype="multipart/form-data"
      )

        legend.font-bold.text-lg.mb-6 CARGAR ARCHIVO - DÉBITO ORGANISMO

        input(
          type="file"
          name="archivoExcel"
          accept=".xlsx,.xls"
          required
        )

        input(
          type="submit"
          value="GENERAR CONSULTA"
          class="mt-4 bg-sky-600 hover:bg-sky-800 text-white font-bold py-2 px-6 rounded"
        )
