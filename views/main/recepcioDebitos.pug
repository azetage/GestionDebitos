extends ../layout/plantilla  


block contenido
 
   
   div(name= 'busqueda_principal')
          div.mt-8.mx-auto.max-w-full.px-6.text-sm.items-center

              .bg-gray-100.py-8.px-10(class="shadow-lg shadow-gray-500/50")
                  form.space-y-5(method= "GET" action="1/main/enviodebitos/consultasDebito" name="formConsulta" noValidate)
                      fieldset.px-10.py-1 
                          legend.px-3.py-3.mt-2.font-bold  CARGAR ARCHIVO - DEBITO ORGANISMO

                              div.py-10(class="grid gap-6 mb-3 md:grid-cols-3")
                                  div(class= "inline-flex flex flex-row")   
                                      .upload-box
                                        input(type="file", name="archivoExcel", id="archivoExcel", accept=".xlsx,.xls", required)

                                     
                                  
                      
                                  br                        
                                  div(class= "inline-flex flex flex-row")
                                          input(  class= "shadow-lg shadow-blue-500/50 w-full text-white font-semibold py-3 shadow-md cursor-pointer rounded-sm bg-sky-500 hover:bg-sky-700 focus:outline-2 focus:outline-offset-2 focus:outline-sky-500 active:bg-sky-700" 
                                              type= 'submit' value= 'GENERAR CONSULTA')


