extends ../layout/plantilla  

  
block contenido
  a.text-gray-500.px-10.font-semibold.py-3.border-2.border-solid.shadow-md.cursor-pointer.rounded-sm.justify-items-end(class= "shadow-lg shadow-blue-500/50" href="/main/recepcionDebitos") INICIO  
  br
  br

  h2.py-2.text-center.text-2xl.font-bold.text-white.bg-sky-500(class= "shadow-lg shadow-blue-500/50")= pagina
    
  h3.py-2.text-center.text-xl.font-bold= archivo

  
  div.mt-10.mx-auto.max-w-7xl.px-6

      if data && data.length
        - const firstCell = data[0][Object.keys(data[0])[0]]
        - let headerIndex = 0
        - let bodyIndex = 0

        - if (firstCell === 'Nro. Legajo')
        -   headerIndex = 0
        -   bodyIndex = 0

        - const headers = Object.keys(data[headerIndex])

        table.w-full.border.border-gray-400.text-sm
          thead.bg-gray-200
            tr
              each key in headers
                th.border.px-3.py-2= key

          tbody
            each fila, i in data
              if i >= bodyIndex
                tr
                  each key in headers
                    td.border.px-3.py-2= fila[key]
      else
        p No hay datos para mostrar
       
      div(class="grid gap-6 mb-3 md:grid-cols-2 shadow-lg shadow-gray-500/50").py-2.text-xl.font-bold.bg-gray-200.text-gray-500.py-3
        div
            h4 Elementos : #{cantidad}
        div
            h4 Monto Total : #{suma} 
  div.mt-8.mx-auto.max-w-full.px-6.text-sm.items-center
     
      .bg-gray-100.py-8.px-10(class="shadow-lg shadow-gray-500/50")
                  
                              form.space-y-5(action=`/upload/grabardebitos` method="POST")   
                                  fieldset.px-10.py-1 
                                      div
                                          input(  class= "shadow-lg shadow-red-500/50 w-full text-white font-semibold py-3 shadow-md cursor-pointer rounded-sm bg-red-500 hover:bg-red-700 focus:outline-2 focus:outline-offset-2 focus:outline-red-500 active:bg-red-700" 
                                                  type= 'submit' value= 'Grabar Debito')


