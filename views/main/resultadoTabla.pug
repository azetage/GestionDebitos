extends ../layout/plantilla  

  
block contenido

  h2.py-2.text-center.text-2xl.font-bold.text-white.bg-sky-500(class= "shadow-lg shadow-blue-500/50")= pagina
    
  h3.py-2.text-center.text-xl.font-bold= archivo

  
  div.mt-10.mx-auto.max-w-7xl.px-6

      if data && data.length
        - const firstCell = data[0][Object.keys(data[0])[0]]
        - let headerIndex = 0
        - let bodyIndex = 0

        - if (firstCell === 'Nro. Legajo')
        -   headerIndex = 0
        -   bodyIndex = 0

        - const headers = Object.keys(data[headerIndex])

        table.w-full.border.border-gray-400.text-sm
          thead.bg-gray-200
            tr
              each key in headers
                th.border.px-3.py-2= key

          tbody
            each fila, i in data
              if i >= bodyIndex
                tr
                  each key in headers
                    td.border.px-3.py-2= fila[key]
      else
        p No hay datos para mostrar
