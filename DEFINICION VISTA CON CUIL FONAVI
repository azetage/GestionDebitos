-- dbo.VISTA_PODERJUDICIAL source

ALTER VIEW dbo.VISTA_PODERJUDICIAL
AS
SELECT        COD, COD_DEB, SUCURSAL, NRO_AGENTE, APEYNOM, DNI_DESC, TAREA, MTO_TOTAL, PLAZO, MTO_CUO, DESC_PT, MTO_ADIC, MTO_INT, MTO_DEUDA, MTO_SEG, GTS_ADM, FEC_ENVIO, FEC_VTO, OBSERV, CUO_DES, 
                         CUO_HAS, USUARIO, FECHA_PROCESO, EQUIPO, NRO, CON_DEUDA, UVI, FECHA_UVI, SWITCHOFFSET(CAST(FEC_ENVIO AS datetimeoffset), '+06:00') AS FECHA_ENVIO_OFFSET, 
                         SWITCHOFFSET(CAST(FEC_VTO AS datetimeoffset), '+06:00') AS FECHA_VTO_OFFSET, MTO_CUO + MTO_ADIC + MTO_DEUDA AS MONTO, '' AS CUIL
FROM            Viviendas_Fonavi.dbo.ENVIO_DEBITO
WHERE        (COD_DEB = 17);
